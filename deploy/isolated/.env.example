# Skopiuj do .env i, jeśli trzeba, przesuń blok portów.
STACK_NAME=apk-demo

HIGSON_VERSION=4.3.3
DEMO_DB_VERSION=4.3.0
APP_IMAGE=decerto/higson-motor-insurance-demo:apk-demo

# Blok 58xxx — z dala od domyślnych portów Higsona (8081, 8082, 38080, 48080),
# żeby nie wejść w drogę stosom już stojącym na serwerze.
PORT_STUDIO=58080
PORT_RUNTIME=58081
PORT_DB_CONSOLE=58082
PORT_DB_TCP=59092
PORT_WEB=58090

APP_CONTEXT_PATH=/demo
LOCALE=en_EN
