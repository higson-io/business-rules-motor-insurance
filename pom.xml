<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<groupId>pl.decerto</groupId>
	<artifactId>motor-insurance</artifactId>
	<version>4.3.0-SNAPSHOT</version>
	<packaging>war</packaging>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
	</parent>

	<properties>
		<maven.compiler.release>17</maven.compiler.release>

		<!-- Higson CLI (snapshot push/pull) -->
		<higson.studio.url>http://localhost:38088/studio</higson.studio.url>
		<!-- Single source of truth for the snapshot: shared by the CLI (pull/push) and the
		     SnapshotDataSourceDemoTest. 'pull' rewrites this directory, 'push' uploads it. -->
		<higson.snapshot.dir>${project.basedir}/src/main/higson</higson.snapshot.dir>
		<!-- Studio integration token. Intentionally empty - never commit a real one.
		     Supply it per invocation instead:
		       mvn higson-cli:push -Dhigson.studio.token=$HIGSON_STUDIO_TOKEN
		     or via a <server>/<profile> entry in ~/.m2/settings.xml. -->
		<higson.studio.token></higson.studio.token>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Higson Runtime Spring Boot Starter (auto-configures HigsonEngine, DataSource, dialect) -->
		<dependency>
			<groupId>io.higson</groupId>
			<artifactId>spring-boot-starter-higson-runtime</artifactId>
			<version>4.3.1</version>
		</dependency>

		<!-- Spring Framework -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context</artifactId>
		</dependency>

		<!-- Database access libraries -->
		<dependency>
			<groupId>com.zaxxer</groupId>
			<artifactId>HikariCP</artifactId>
		</dependency>

		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<version>2.1.212</version>
		</dependency>

		<!-- Collections support-->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-collections4</artifactId>
			<version>4.4</version>
		</dependency>

		<!-- Testing: JUnit 5 (Jupiter), AssertJ and spring-test/MockMvc.
		     Version inherited from spring-boot-starter-parent - do not pin. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

    </dependencies>


    <build>
        <finalName>motor-insurance</finalName>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.10.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.0.0</version>
					<configuration>
						<executable>npm</executable>
						<!-- The Angular workspace lives in frontend/; without this the plugin runs at
						     ${project.basedir} and would pick up the wrong package.json.
						     "npm run build" there is "npm ci && ng build" - lockfile-deterministic,
						     self-bootstrapping, and independent of Vitest and Playwright. -->
						<workingDirectory>${project.basedir}/frontend</workingDirectory>
						<arguments>
							<argument>run</argument>
							<argument>build</argument>
						</arguments>
					</configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>exec</goal>
                            </goals>
                            <phase>prepare-package</phase>
                        </execution>
                    </executions>
                </plugin>
				<!-- Everything the frontend build generates lives under frontend/ and is wiped here.
				     Nothing is emitted into src/main/webapp: that directory is version-controlled and
				     is not touched by "mvn clean", so hashed bundles would accumulate there forever. -->
				<plugin>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.2.0</version>
					<configuration>
						<filesets>
							<!-- No <includes>: with one, the plugin deletes the contents and leaves an
							     empty directory behind. These filesets remove the directories outright,
							     so "mvn clean" really does return the tree to a clean-clone state. -->
							<fileset>
								<directory>frontend/node_modules</directory>
								<followSymlinks>false</followSymlinks>
							</fileset>
							<fileset>
								<directory>frontend/dist</directory>
								<followSymlinks>false</followSymlinks>
							</fileset>
							<fileset>
								<!-- Angular CLI build cache -->
								<directory>frontend/.angular</directory>
								<followSymlinks>false</followSymlinks>
							</fileset>
						</filesets>
					</configuration>
				</plugin>
				<!-- Pack the Angular bundle at the WAR root, which is exactly where the previous
				     frontend lived, so ApplicationConfig's forward:/index.html needs no change.
				     Version deliberately omitted: spring-boot-starter-parent manages this plugin at
				     3.4.0 and its pluginManagement entry also supplies an <archive> block that an
				     explicit <version> here would clobber. Do NOT pin it. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-war-plugin</artifactId>
					<configuration>
						<webResources>
							<resource>
								<directory>${project.basedir}/frontend/dist/motor-insurance/browser</directory>
							</resource>
						</webResources>
					</configuration>
				</plugin>
				<!-- Higson CLI: push/pull the snapshot in ${higson.snapshot.dir} to/from Higson Studio.
				     No executions bound => run on demand:
				       mvn higson-cli:pull   (download Studio -> src/main/higson)
				       mvn higson-cli:push   (upload src/main/higson -> Studio; add -Dautocommit=true to commit)
				     Push/pull use safe defaults (nothing deleted, no auto-commit);
				     add <pullOptions>/<pushOptions> here to narrow scope. -->
				<plugin>
					<groupId>io.higson</groupId>
					<artifactId>higson-cli-maven-plugin</artifactId>
					<version>4.3.1</version>
					<configuration>
						<higsonUrl>${higson.studio.url}</higsonUrl>
						<higsonToken>${higson.studio.token}</higsonToken>
						<higsonSnapshotDir>${higson.snapshot.dir}</higsonSnapshotDir>
						<logFilePath>${project.basedir}/higson-cli.log</logFilePath>
					</configuration>
				</plugin>
				<!-- Pin the test JVM timezone. Motor.createDriver seeds dateOfBirth as
				     "today - 40 years, start-of-day, system TZ", so an unpinned zone makes every
				     date-carrying test result machine-dependent (+00:00 in the container,
				     +02:00 on a Europe/Warsaw box).
				     Version inherited from spring-boot-starter-parent - do not pin. -->
				<plugin>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<argLine>-Duser.timezone=UTC</argLine>
					</configuration>
				</plugin>
            </plugins>
    </build>

	<profiles>
		<profile>
			<id>all_in_one</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<executable>true</executable>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>repackage</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
