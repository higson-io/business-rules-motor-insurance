code = "demo.life.group.eligibility"
description = "Czy program kwalifikuje sie do oferty. Bez wiersza domyslnego, bo w tabeli o samych kolumnach przedzialowych wiersz \"* - *\" dopasowuje sie ROWNOLEGLE z wlasciwym pasmem i daje dwie sprzeczne odpowiedzi. Brak dopasowania zwraca null, a funkcja group.eligible czyta to jako odmowe."
nullable = true
dictionary = false
cacheable = true
distinct = false
aiModelSource = false
eagerReload = false
hotswapReload = false
sort = ""
slave = false
