code = "demo.property.apk.reason"
description = "Wyzwalacze zdan uzasadnienia, ktore nie naleza do zadnej innej tabeli. COVERAGE: jaka czesc potrzeb pokrywa propozycja. MANUAL_SUM: stosunek sumy podanej recznie do wyliczonej - pasmo 0.99-1.01 jest CELOWE, roznica ponizej procenta nie jest warta zdania w dokumencie. BUDGET_ALTERNATIVE: czy w oczekiwanej skladce cokolwiek sie miesci. Do 7 wrzesnia 2026 wszystkie trzy byly warunkami w Javie, wiec proga tolerancji nie dalo sie zmienic bez wdrozenia."
nullable = true
dictionary = false
cacheable = true
distinct = false
aiModelSource = false
eagerReload = false
hotswapReload = false
sort = ""
slave = false
