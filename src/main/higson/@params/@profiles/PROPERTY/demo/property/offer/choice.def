code = "demo.property.offer.choice"
description = "Rek. 9.3 - w ofercie ma stac, czy klient poszedl za rekomendacja, czy od niej odszedl i w ktora strone, oraz co dokladnie o tym napisac. Wejsciem jest ROZNICA LICZBY POKRYC miedzy pakietem wybranym a rekomendowanym (util demo.property.util.choiceDelta). Do 11 wrzesnia stala obok druga tabela kluczowana samym kodem rodzaju; scalone, bo KAZDY z trzech rodzajow przechodzil przez obie, wiec kod byl kluczem istniejacym wylacznie po to, zeby przejsc do drugiej tabeli. Zakresy DOMKNIETE z obu stron: otwarty koniec lapie null i bije wiersz gwiazdkowy (W-30)."
nullable = true
dictionary = false
cacheable = true
distinct = false
aiModelSource = false
eagerReload = false
hotswapReload = false
sort = ""
slave = false
label = "Wybor klienta wobec rekomendacji i notatka do oferty"

[[inputLevel]]
code = "delta"
label = "o ile wiecej pokryc niz w rekomendacji"
type = "number"
matcher = "between/ii"
reverseMatcher = false
levelCreator = "$f demo.property.util.choiceDelta"
source = "$f demo.property.util.choiceDelta"
union = false

[[outputLevel]]
code = "kind"
label = "nazwa zgodnosci wyboru"
type = "string"
external = false
array = false

[[outputLevel]]
code = "label"
label = "naglowek notatki w ofercie"
type = "string"
external = false
array = false

[[outputLevel]]
code = "text"
label = "tresc notatki w ofercie"
type = "string"
external = false
array = false

[[outputLevel]]
code = "requiresAcknowledgement"
label = "czy wymaga potwierdzenia klienta"
type = "boolean"
external = false
array = false
