code = "demo.property.apk.need"
description = "ETAP 1: z odpowiedzi klienta powstaje lista potrzeb. Kolumny to ODPOWIEDZI - te z ankiety i te o przedmiocie ubezpieczenia - a gwiazdka znaczy nie ma znaczenia. Czytasz wiersz i wiesz, z czego wynika dana potrzeba. Poziomy maja UNION, wiec jeden odczyt oddaje wszystkie pasujace wiersze naraz. PIERWSZENSTWO: gdy dwie odpowiedzi wskazuja to samo pokrycie, klient slyszy zdanie o nizszym numerze - 1 to potrzeba, ktora ZGLOSIL, 2 to ta, ktora WYWNIOSKOWALISMY z przedmiotu."
nullable = true
dictionary = false
cacheable = true
distinct = false
aiModelSource = false
eagerReload = false
hotswapReload = false
sort = "priority ascending"
slave = false
label = "Jakie potrzeby wynikają z odpowiedzi klienta"

[[inputLevel]]
code = "needsProperty"
label = "potrzeba ubezpieczenia nieruchomosci"
type = "string"
reverseMatcher = false
property = "quote.needs.property"
source = "quote.needs.property"
union = true

