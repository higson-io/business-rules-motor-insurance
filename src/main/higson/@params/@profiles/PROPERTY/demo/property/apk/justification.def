code = "demo.property.apk.justification"
description = "ETAP 3: co powiedziec klientowi o rekomendacji. Jeden wiersz na zdanie: po lewej WARUNEK, po prawej TRESC i miejsce w dokumencie. Kolumny warunku to fakty o wyniku analizy, kazdy jednym slowem - gwiazdka znaczy nie ma znaczenia. W tresci {0} {1} to liczby, ktore aplikacja podstawia. Poziomy maja UNION, wiec jeden odczyt oddaje wszystkie pasujace wiersze naraz - cale uzasadnienie."
nullable = true
dictionary = false
cacheable = true
distinct = false
aiModelSource = false
eagerReload = false
hotswapReload = false
sort = ""
slave = false
label = "Powody decyzji — kiedy padają i jak brzmią"

