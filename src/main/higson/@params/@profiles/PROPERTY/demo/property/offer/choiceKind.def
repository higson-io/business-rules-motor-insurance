code = "demo.property.offer.choiceKind"
description = "Rek. 9.3 - w ofercie ma stac, czy klient poszedl za rekomendacja, czy od niej odszedl i w ktora strone. Wejsciem jest ROZNICA LICZBY POKRYC miedzy pakietem wybranym a rekomendowanym, ktora liczy util demo.property.util.choiceDelta; tabela nadaje jej nazwe. Do 11 wrzesnia byla to roznica POZYCJI w drabince - miara kolejnosci na ekranie, nie zakresu ochrony. Zakresy sa DOMKNIETE z obu stron celowo: otwarty koniec dopasowuje takze null i bije wiersz gwiazdkowy (W-30), a null znaczy tu \"nie ma jeszcze czego oceniac\" i ma nie pasowac do niczego."
nullable = true
dictionary = false
cacheable = true
distinct = false
aiModelSource = false
eagerReload = false
hotswapReload = false
sort = ""
slave = false
label = "Czy klient poszedl za rekomendacja"

[[inputLevel]]
code = "delta"
label = "o ile wiecej pokryc niz w rekomendacji"
type = "number"
matcher = "between/ii"
reverseMatcher = false
levelCreator = "$f demo.property.util.choiceDelta"
source = "$f demo.property.util.choiceDelta"
union = false

[[outputLevel]]
code = "kind"
label = "nazwa zgodnosci wyboru"
type = "string"
external = false
array = false
