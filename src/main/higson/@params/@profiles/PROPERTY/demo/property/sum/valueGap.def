code = "demo.property.sum.valueGap"
description = "Stosunek wartosci, na ktora klient szacuje nieruchomosc, do sumy wyliczonej z metrazu i stawki. Tabela nazywa nie tylko wynik, ale i SKUTEK: reasonCode to gotowy kod zdania w uzasadnieniu. Do 7 wrzesnia 2026 Java skladala ten kod jako 'VALUE_' plus outcome, wiec zmiana slowa w tej kolumnie dawala puste zdanie i zadnego bledu. Kolumny severity, warning i remedy usuniete - nikt ich nie czytal, a ich tresc powtarzala zdania z apk.recommendation.reason."
nullable = false
dictionary = false
cacheable = true
distinct = false
aiModelSource = false
eagerReload = false
hotswapReload = false
sort = ""
slave = false
label = "Oszacowanie klienta a suma z wyliczenia"

[[inputLevel]]
code = "ratio"
label = "oszacowanie do sumy wyliczonej"
type = "number"
matcher = "between/ii"
reverseMatcher = false
property = "quote.value.ratio"
source = "quote.value.ratio"
union = false

[[outputLevel]]
code = "outcome"
label = "wynik porownania"
type = "string"
external = false
array = false

[[outputLevel]]
code = "reasonCode"
label = "kod zdania w uzasadnieniu"
type = "string"
external = false
array = false
