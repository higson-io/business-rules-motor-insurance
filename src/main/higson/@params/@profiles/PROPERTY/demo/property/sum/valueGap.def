code = "demo.property.sum.valueGap"
description = "Stosunek wartosci, na ktora klient szacuje nieruchomosc, do sumy wyliczonej z metrazu i stawki. reasonCode to gotowy kod zdania w uzasadnieniu. UWAGA: poziom wejsciowy nazywa sie quote.sums.valueRatio i musi sie zgadzac ze sciezka, pod ktora Java publikuje ten stosunek - do 8 wrzesnia 2026 tabela czekala na quote.value.ratio, ktorego nikt nie ustawial, wiec zawsze trafiala w pierwszy przedzial i zdanie o wartosci nie zalezalo od tego, co klient wpisal. Kolumna outcome usunieta - nikt jej nie czytal, kod zdania niesie reasonCode."
nullable = false
dictionary = false
cacheable = true
distinct = false
aiModelSource = false
eagerReload = false
hotswapReload = false
sort = ""
slave = false
label = "Oszacowanie klienta a suma z wyliczenia"

[[inputLevel]]
code = "ratio"
label = "oszacowanie do sumy wyliczonej"
type = "number"
matcher = "between/ii"
reverseMatcher = false
property = "quote.sums.valueRatio"
source = "quote.sums.valueRatio"
union = false

[[outputLevel]]
