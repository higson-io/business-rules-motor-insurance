<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<domainDefinition>
    <exportType>DEFINITION_ONLY</exportType>
    <domainTypes>
        <domainType>
            <profile>PROPERTY</profile>
            <code>COVER</code>
            <name>Pokrycie</name>
            <description>Przedmiot albo ryzyko, ktore klient kupuje. Atrybuty sa spisem tresci: skad bierze sie suma, jaka jest stawka i jaki limit. To, W KTORYM PAKIECIE pokrycie sie znajduje, NIE jest juz jego cecha - sklad pakietu wisi pod pakietem (VARIANTS[..]/COVERS), bo to relacja pakietu, a nie wlasciwosc pokrycia.</description>
            <rootType>false</rootType>
            <typeNature>PRODUCT</typeNature>
            <typeAttributes>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>POSITION</code>
                    <name>Kolejnosc na ekranie</name>
                    <order>1</order>
                    <groupOrder>1</groupOrder>
                    <defaultRefType>PARAMETER</defaultRefType>
                    <defaultRefName>demo.property.cover.position</defaultRefName>
                </typeAttribute>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>SUM_BASIS</code>
                    <name>Skad bierze sie suma</name>
                    <order>1</order>
                    <groupOrder>2</groupOrder>
                    <defaultRefType>PARAMETER</defaultRefType>
                    <defaultRefName>demo.property.cover.sumBasis [basis]</defaultRefName>
                </typeAttribute>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>SUM_REFERENCE</code>
                    <name>Pokrycie odniesienia dla sumy pochodnej</name>
                    <order>2</order>
                    <groupOrder>2</groupOrder>
                    <defaultRefType>PARAMETER</defaultRefType>
                    <defaultRefName>demo.property.cover.sumBasis [reference]</defaultRefName>
                </typeAttribute>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>RATE</code>
                    <name>Stawka taryfowa</name>
                    <order>1</order>
                    <groupOrder>3</groupOrder>
                    <defaultRefType>PARAMETER</defaultRefType>
                    <defaultRefName>demo.property.tariff.baseRate [rate]</defaultRefName>
                </typeAttribute>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>RATE_BASIS</code>
                    <name>Podstawa stawki - promile sumy albo kwota</name>
                    <order>2</order>
                    <groupOrder>3</groupOrder>
                    <defaultRefType>PARAMETER</defaultRefType>
                    <defaultRefName>demo.property.tariff.baseRate [basis]</defaultRefName>
                </typeAttribute>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>CAP_KIND</code>
                    <name>Rodzaj limitu</name>
                    <order>1</order>
                    <groupOrder>4</groupOrder>
                    <defaultRefType>PARAMETER</defaultRefType>
                    <defaultRefName>demo.property.cover.limitRule [capKind]</defaultRefName>
                </typeAttribute>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>CAP_LABEL</code>
                    <name>Opis limitu dla klienta</name>
                    <order>2</order>
                    <groupOrder>4</groupOrder>
                    <defaultRefType>PARAMETER</defaultRefType>
                    <defaultRefName>demo.property.cover.limitRule [label]</defaultRefName>
                </typeAttribute>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>EFFECTIVE_LIMIT</code>
                    <name>Efektywny limit - nizszy z ulamka sumy i kwoty</name>
                    <order>3</order>
                    <groupOrder>4</groupOrder>
                    <defaultRefType>FUNCTION</defaultRefType>
                    <defaultRefName>demo.property.limit.effective</defaultRefName>
                </typeAttribute>
            </typeAttributes>
        </domainType>
        <domainType>
            <profile>PROPERTY</profile>
            <code>PACKAGE_COVER</code>
            <name>Pokrycie w pakiecie</name>
            <description>Odwolanie do pokrycia, ktore wchodzi w sklad tego pakietu. KODEM, a nie kopia - element nie ma zadnego atrybutu, bo cala konfiguracja pokrycia (stawka, suma, limit) zostaje w /PRODUCTS[HOME]/COVERS. Gdyby ten typ mial atrybuty, ta sama rzecz dalaby sie ustawic w dwoch miejscach i zaczelaby sie rozjezdzac.</description>
            <rootType>false</rootType>
            <typeNature>PRODUCT</typeNature>
        </domainType>
        <domainType>
            <profile>PROPERTY</profile>
            <code>PRODUCT</code>
            <name>Produkt majatkowy</name>
            <description>Punkt startu calej konfiguracji. Rozwiniecie tego wezla daje wszystko: co sprzedajemy (COVERS, VARIANTS), o co pytamy (QUESTIONS, SUBJECT) i reguly, ktore to licza (APK, SUMS, ZONES, PRICING, OFFER). Kazda regula ma pod soba USES z regulami, ktorych uzywa, wiec od produktu da sie zejsc po nitce do kazdej tabeli i funkcji. Zadna nie lezy poza tym drzewem.</description>
            <rootType>false</rootType>
            <typeNature>PRODUCT</typeNature>
            <typeCollections>
                <typeCollection>
                    <code>APK</code>
                    <name>Reguly analizy potrzeb</name>
                    <multiple>true</multiple>
                    <visible>true</visible>
                    <order>0</order>
                    <collectionTypeCode>RULE</collectionTypeCode>
                </typeCollection>
                <typeCollection>
                    <code>COVERS</code>
                    <name>Pokrycia</name>
                    <multiple>true</multiple>
                    <visible>true</visible>
                    <order>0</order>
                    <collectionTypeCode>COVER</collectionTypeCode>
                </typeCollection>
                <typeCollection>
                    <code>OFFER</code>
                    <name>Oferta</name>
                    <multiple>true</multiple>
                    <visible>true</visible>
                    <order>0</order>
                    <collectionTypeCode>RULE</collectionTypeCode>
                </typeCollection>
                <typeCollection>
                    <code>PRICING</code>
                    <name>Wycena skladki</name>
                    <multiple>true</multiple>
                    <visible>true</visible>
                    <order>0</order>
                    <collectionTypeCode>RULE</collectionTypeCode>
                </typeCollection>
                <typeCollection>
                    <code>QUESTIONS</code>
                    <name>Pytania analizy potrzeb (APK)</name>
                    <multiple>true</multiple>
                    <visible>true</visible>
                    <order>0</order>
                    <collectionTypeCode>QUESTION</collectionTypeCode>
                </typeCollection>
                <typeCollection>
                    <code>SUBJECT</code>
                    <name>Przedmiot ubezpieczenia i sytuacja (poza APK)</name>
                    <multiple>true</multiple>
                    <visible>true</visible>
                    <order>0</order>
                    <collectionTypeCode>QUESTION</collectionTypeCode>
                </typeCollection>
                <typeCollection>
                    <code>SUMS</code>
                    <name>Sumy ubezpieczenia</name>
                    <multiple>true</multiple>
                    <visible>true</visible>
                    <order>0</order>
                    <collectionTypeCode>RULE</collectionTypeCode>
                </typeCollection>
                <typeCollection>
                    <code>VARIANTS</code>
                    <name>Pakiety</name>
                    <multiple>true</multiple>
                    <visible>true</visible>
                    <order>0</order>
                    <collectionTypeCode>VARIANT</collectionTypeCode>
                </typeCollection>
                <typeCollection>
                    <code>ZONES</code>
                    <name>Strefy i powodz</name>
                    <multiple>true</multiple>
                    <visible>true</visible>
                    <order>0</order>
                    <collectionTypeCode>RULE</collectionTypeCode>
                </typeCollection>
            </typeCollections>
            <typeAttributes>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>APK_REGIME</code>
                    <name>Rezim analizy potrzeb</name>
                    <order>1</order>
                    <groupOrder>1</groupOrder>
                    <defaultRefType>PARAMETER</defaultRefType>
                    <defaultRefName>demo.property.apk.regime [name]</defaultRefName>
                </typeAttribute>
            </typeAttributes>
        </domainType>
        <domainType>
            <profile>PROPERTY</profile>
            <code>QUESTION</code>
            <name>Pytanie APK</name>
            <description>Pytanie analizy potrzeb jako element domeny, a nie wiersz tabeli: wiersz zawsze istnieje, a element moze NIE ISTNIEC w danej wersji regionu - i na tej roznicy stoi cala demonstracja wersjonowania. Element niesie cztery rzeczy: o co pytamy, jakiego rodzaju jest odpowiedz, gdzie ona laduje i kiedy pytanie jest widoczne. Reszta ustawien siedzi w jednym wierszu tabeli demo.property.apk.question.</description>
            <rootType>false</rootType>
            <typeNature>PRODUCT</typeNature>
            <typeAttributes>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>TEXT</code>
                    <name>Tresc pytania</name>
                    <order>1</order>
                    <groupOrder>1</groupOrder>
                    <defaultRefType>LITERAL</defaultRefType>
                </typeAttribute>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>KIND</code>
                    <name>Rodzaj odpowiedzi</name>
                    <order>2</order>
                    <groupOrder>1</groupOrder>
                    <defaultRefType>LITERAL</defaultRefType>
                    <defaultRefName>TEXT</defaultRefName>
                </typeAttribute>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>CONTEXT_PATH</code>
                    <name>Gdzie laduje odpowiedz</name>
                    <order>3</order>
                    <groupOrder>1</groupOrder>
                    <defaultRefType>LITERAL</defaultRefType>
                </typeAttribute>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>IS_VISIBLE</code>
                    <name>Kiedy pokazac</name>
                    <order>1</order>
                    <groupOrder>2</groupOrder>
                    <defaultRefType>PARAMETER</defaultRefType>
                    <defaultRefName>demo.property.apk.question.visibility</defaultRefName>
                </typeAttribute>
            </typeAttributes>
        </domainType>
        <domainType>
            <profile>PROPERTY</profile>
            <code>ROOT</code>
            <name>ROOT</name>
            <description>Korzen drzewa domeny profilu PROPERTY</description>
            <rootType>true</rootType>
            <typeNature>PRODUCT</typeNature>
            <typeCollections>
                <typeCollection>
                    <code>PRODUCTS</code>
                    <name>Produkty</name>
                    <multiple>true</multiple>
                    <visible>true</visible>
                    <order>0</order>
                    <collectionTypeCode>PRODUCT</collectionTypeCode>
                </typeCollection>
            </typeCollections>
        </domainType>
        <domainType>
            <profile>PROPERTY</profile>
            <code>RULE</code>
            <name>Regula</name>
            <description>Jedna regula silnika widoczna w drzewie. Nazwa elementu mowi, CO ta regula rozstrzyga, atrybut RULE prowadzi do tabeli, funkcji albo flow, ktory to robi, a kolekcja USES pokazuje reguly, z ktorych ta korzysta - i tak schodzi sie w dol az do tabeli z liczbami. Regula uzywana w dwoch miejscach wisi pod tym, kto jest jej glownym odbiorca; drugie uzycie opisane jest slowami.</description>
            <rootType>false</rootType>
            <typeNature>PRODUCT</typeNature>
            <typeCollections>
                <typeCollection>
                    <code>USES</code>
                    <name>Korzysta z regul</name>
                    <multiple>true</multiple>
                    <visible>true</visible>
                    <order>0</order>
                    <collectionTypeCode>RULE</collectionTypeCode>
                </typeCollection>
            </typeCollections>
            <typeAttributes>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>RULE</code>
                    <name>Tabela, funkcja albo flow rozstrzygajace</name>
                    <order>1</order>
                    <groupOrder>1</groupOrder>
                    <defaultRefType>LITERAL</defaultRefType>
                </typeAttribute>
            </typeAttributes>
        </domainType>
        <domainType>
            <profile>PROPERTY</profile>
            <code>SECTION</code>
            <name>Sekcja ankiety APK</name>
            <description>Galaz grupujaca pytania. Sekcja jest ELEMENTEM DOMENY, a nie wartoscia atrybutu na pytaniu - dzieki temu dolozenie galezi daje nowa sekcje, sekcja ma wlasne ustawienia, a przypisanie do wersji regionu obejmuje CALA sekcje razem z jej pytaniami. KIND rozstrzyga, czy to ankieta (FORM), czy dane, ktore juz mamy (KNOWN).</description>
            <rootType>false</rootType>
            <typeNature>PRODUCT</typeNature>
            <typeCollections>
                <typeCollection>
                    <code>QUESTIONS</code>
                    <name>Pytania w sekcji</name>
                    <multiple>true</multiple>
                    <visible>true</visible>
                    <order>0</order>
                    <collectionTypeCode>QUESTION</collectionTypeCode>
                </typeCollection>
            </typeCollections>
            <typeAttributes>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>TITLE</code>
                    <name>Naglowek sekcji</name>
                    <order>1</order>
                    <groupOrder>1</groupOrder>
                    <defaultRefType>LITERAL</defaultRefType>
                </typeAttribute>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>POSITION</code>
                    <name>Kolejnosc sekcji</name>
                    <order>2</order>
                    <groupOrder>1</groupOrder>
                    <defaultRefType>LITERAL</defaultRefType>
                    <defaultRefName>0</defaultRefName>
                </typeAttribute>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>KIND</code>
                    <name>FORM (pytamy) albo KNOWN (juz wiemy)</name>
                    <order>3</order>
                    <groupOrder>1</groupOrder>
                    <defaultRefType>LITERAL</defaultRefType>
                    <defaultRefName>FORM</defaultRefName>
                </typeAttribute>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>IS_VISIBLE</code>
                    <name>Kiedy pokazac</name>
                    <order>1</order>
                    <groupOrder>2</groupOrder>
                    <defaultRefType>PARAMETER</defaultRefType>
                    <defaultRefName>demo.property.apk.section.visibility</defaultRefName>
                </typeAttribute>
            </typeAttributes>
        </domainType>
        <domainType>
            <profile>PROPERTY</profile>
            <code>VARIANT</code>
            <name>Wariant</name>
            <description>Pakiet ochrony. Drabinka jest scisla - kazdy wariant zawiera wszystko, co poprzedni. Sklad pakietu wisi POD NIM w drzewie (kolekcja COVERS), zamiast byc para w tabeli dostepnosci: zeby zobaczyc, co jest w pakiecie, otwiera sie pakiet.</description>
            <rootType>false</rootType>
            <typeNature>PRODUCT</typeNature>
            <typeCollections>
                <typeCollection>
                    <code>COVERS</code>
                    <name>Pokrycia w pakiecie</name>
                    <multiple>true</multiple>
                    <visible>true</visible>
                    <order>0</order>
                    <collectionTypeCode>PACKAGE_COVER</collectionTypeCode>
                </typeCollection>
            </typeCollections>
            <typeAttributes>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>POSITION</code>
                    <name>Miejsce w drabince</name>
                    <order>1</order>
                    <groupOrder>1</groupOrder>
                    <defaultRefType>PARAMETER</defaultRefType>
                    <defaultRefName>demo.property.variant.position</defaultRefName>
                </typeAttribute>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>LIABILITY_SUM</code>
                    <name>Suma gwarancyjna OC</name>
                    <order>2</order>
                    <groupOrder>1</groupOrder>
                    <defaultRefType>PARAMETER</defaultRefType>
                    <defaultRefName>demo.property.variant.liabilitySum</defaultRefName>
                </typeAttribute>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>IS_AVAILABLE</code>
                    <name>Czy dostepny w tej strefie</name>
                    <order>1</order>
                    <groupOrder>2</groupOrder>
                    <defaultRefType>PARAMETER</defaultRefType>
                    <defaultRefName>demo.property.variant.availability [available]</defaultRefName>
                </typeAttribute>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>UNAVAILABLE_REASON</code>
                    <name>Powod niedostepnosci</name>
                    <order>2</order>
                    <groupOrder>2</groupOrder>
                    <defaultRefType>PARAMETER</defaultRefType>
                    <defaultRefName>demo.property.variant.availability [reason]</defaultRefName>
                </typeAttribute>
                <typeAttribute>
                    <attributeType>business</attributeType>
                    <code>PREMIUM</code>
                    <name>Skladka - flow wyceny wariantu</name>
                    <order>1</order>
                    <groupOrder>3</groupOrder>
                    <defaultRefType>FLOW</defaultRefType>
                    <defaultRefName>demo.property.calculateQuote</defaultRefName>
                </typeAttribute>
            </typeAttributes>
        </domainType>
    </domainTypes>
</domainDefinition>
